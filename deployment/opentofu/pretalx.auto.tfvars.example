aws_region         = "us-east-1"
project_name       = "pretalx"
domain_name        = "pretalx.example.com"
route53_zone_id    = "Z0123456789ABCDEF"
image_tag          = "2026-09-23"

# Networking: by default a new VPC is created (see vpc_cidr, vpc_az_count,
# single_nat_gateway). To use an existing VPC instead, set all three:
# vpc_id             = "vpc-0123456789abcdef0"
# public_subnet_ids  = ["subnet-aaaaaaaaaaaaaaaaa", "subnet-bbbbbbbbbbbbbbbbb"]
# private_subnet_ids = ["subnet-ccccccccccccccccc", "subnet-ddddddddddddddddd"]

smtp_from     = "noreply@pretalx.example.com"
smtp_host     = "email-smtp.us-east-1.amazonaws.com"
smtp_user     = "SES_SMTP_USERNAME"
smtp_password = "SES_SMTP_PASSWORD"